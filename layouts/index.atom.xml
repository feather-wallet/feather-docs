{{- $base := site.BaseURL | strings.TrimSuffix "/" -}}
{{- $date := now.Format "2006-01-02T15:04:05-07:00" -}}
{{ `<?xml version="1.0" encoding="utf-8"?>` | safeHTML }}<feed xmlns="http://www.w3.org/2005/Atom" ><link href="{{ $base }}/atom.xml" rel="self" type="application/atom+xml" /><link href="{{ $base }}/" rel="alternate" type="text/html" /><updated>{{ $date | safeHTML }}</updated><id>{{ $base }}/atom.xml</id><title type="html">{{ site.Title }}</title><subtitle>{{ site.Params.description }}</subtitle></feed>
