{{ `<?xml version="1.0" encoding="UTF-8"?>` | safeHTML }}
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{{- $base := site.BaseURL | strings.TrimSuffix "/" -}}
{{- $date := now.Format "2006-01-02T15:04:05-07:00" -}}
{{- $guides := sort (where site.RegularPages "Section" "guides") "File.BaseFileName" "asc" -}}
{{- range $guides }}
<url>
<loc>{{ $base }}/guides/{{ .File.BaseFileName }}</loc>
<lastmod>{{ $date | safeHTML }}</lastmod>
</url>
{{- end }}
<url>
<loc>{{ $base }}/</loc>
</url>
</urlset>
